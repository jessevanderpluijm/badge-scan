NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Absolute URL of the deployed site (no trailing slash). Used for canonical
# tags, Open Graph URLs, sitemap.xml and robots.txt. Required in production.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.com

# Server-side secrets for the /demo flow. The form runs as a Next.js
# Server Action that inserts into demo_requests with the service role
# key (so RLS can't block it) and emails the team via Resend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
RESEND_API_KEY=re_YOUR_RESEND_KEY
DEMO_NOTIFICATION_EMAIL=you@yourdomain.com
# Optional — defaults to "Badge Scan <onboarding@resend.dev>" if unset.
# Once you've verified a domain in Resend, swap to e.g.
# "Badge Scan <demos@yourdomain.com>".
DEMO_NOTIFICATION_FROM=

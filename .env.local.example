NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Absolute URL of the deployed site (no trailing slash). Used for canonical
# tags, Open Graph URLs, sitemap.xml and robots.txt. Required in production.
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.com

# Demo-request notification email (server-side, never exposed to the browser).
# Configure these in Vercel → Settings → Environment Variables; they're only
# needed in production / preview so the webhook from Supabase has somewhere
# to land. The values here are documentation, not runtime defaults.
SUPABASE_WEBHOOK_SECRET=generate-a-long-random-string
RESEND_API_KEY=re_YOUR_RESEND_KEY
DEMO_NOTIFICATION_EMAIL=you@yourdomain.com
# Optional — defaults to "Badge Scan <onboarding@resend.dev>" if unset.
# Once you've verified a domain in Resend, swap to e.g.
# "Badge Scan <demos@yourdomain.com>".
DEMO_NOTIFICATION_FROM=
